DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=2048

TCM_REASON_BASE_URL=https://your-tcmreason-host
TCM_REASON_API_KEY=
TCM_REASON_MODEL=TCMReason
TCM_REASON_MAX_TOKENS=1024
TCM_REASON_TEMPERATURE=0.3
TCM_REASON_VERIFY=false

TCM_NEO4J_URI=neo4j://localhost:7687
TCM_NEO4J_USERNAME=neo4j
TCM_NEO4J_PASSWORD=

AI_POSTGRES_URL=jdbc:postgresql://localhost:5434/tcmseek_ai
AI_POSTGRES_USERNAME=tcmseek
AI_POSTGRES_PASSWORD=tcmseek_dev
AI_CONVERSATION_PERSISTENCE_ENABLED=true
AI_CONVERSATION_CONTEXT_MESSAGE_LIMIT=20
AI_CONVERSATION_SUMMARY_ENABLED=true
AI_CONVERSATION_SUMMARY_TRIGGER_MESSAGE_COUNT=12
AI_CONVERSATION_SUMMARY_REFRESH_MESSAGE_COUNT=6
AI_CONVERSATION_SUMMARY_SOURCE_MESSAGE_LIMIT=40
AI_MEMORY_ENABLED=true
AI_MEMORY_MAX_ITEMS=5
AI_MEMORY_SOURCE_MESSAGE_LIMIT=20

AI_VECTOR_ENABLED=true
AI_VECTOR_POSTGRES_URL=jdbc:postgresql://localhost:5434/tcmseek_ai
AI_VECTOR_POSTGRES_USERNAME=tcmseek
AI_VECTOR_POSTGRES_PASSWORD=tcmseek_dev
AI_VECTOR_DIMENSION=1024
AI_VECTOR_SEARCH_LIMIT=30
AI_VECTOR_INDEX_LIMIT=1000
QWEN_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
QWEN_EMBEDDING_API_KEY=local
QWEN_EMBEDDING_MODEL=BAAI/bge-m3

AI_REQUEST_TIMEOUT=60s
AI_MAX_RETRIES=0
AI_RETRY_BACKOFF=500ms
AI_TOOL_QUERY_LIMIT=1000
AI_TOOL_ANSWER_ITEM_LIMIT=8
AI_MAX_REPLY_CHARS=4000
AI_HOST=0.0.0.0
AI_PORT=8088
